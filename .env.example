# Puzzle Parser API URLs
# Set these to your deployed serverless function URLs
#
# Both platforms can be used simultaneously - the user selects which one in the UI

# ============================================================================
# Cloudflare Workers URL
# ============================================================================
# For local development:
# VITE_CLOUDFLARE_API_URL=http://localhost:8787
#
# For production (after deploying with `npm run deploy` in worker/):
# VITE_CLOUDFLARE_API_URL=https://puzzle-parser-api.your-subdomain.workers.dev

VITE_CLOUDFLARE_API_URL=http://localhost:8787

# ============================================================================
# Vercel Functions URL
# ============================================================================
# For local development:
# VITE_VERCEL_API_URL=http://localhost:3000/api/puzzle-parser
#
# For production (after deploying to Vercel):
# VITE_VERCEL_API_URL=https://your-project.vercel.app/api/puzzle-parser

VITE_VERCEL_API_URL=http://localhost:3000/api/puzzle-parser
