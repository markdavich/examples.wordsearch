# Puzzle Parser API URL
# Set this to your deployed serverless function URL
#
# For local development with Cloudflare Workers:
# VITE_PUZZLE_API_URL=http://localhost:8787
#
# For local development with Vercel:
# VITE_PUZZLE_API_URL=http://localhost:3000/api/puzzle-parser
#
# For production (Cloudflare Workers):
# VITE_PUZZLE_API_URL=https://puzzle-parser-api.your-subdomain.workers.dev
#
# For production (Vercel):
# VITE_PUZZLE_API_URL=https://your-project.vercel.app/api/puzzle-parser

VITE_PUZZLE_API_URL=http://localhost:8787
